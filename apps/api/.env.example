# =============================================================================
# Mariana - environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Variables marked "(required)" must be set or the application fails to start.
# Variables with a default are optional; the shown value is the fallback.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: development | production | test (default: development)
NODE_ENV=development
# HTTP port the Fastify server listens on (default: 3252)
PORT=3252

# -----------------------------------------------------------------------------
# HTTP API security (required)
# -----------------------------------------------------------------------------
# Key for every non-webhook route: send `Authorization: Bearer <ADMIN_API_KEY>`.
# At least 32 characters, no whitespace. Generate with: openssl rand -base64 48
ADMIN_API_KEY=
# Signs the Google OAuth connect ticket and state. At least 32 characters and
# different from ADMIN_API_KEY, no whitespace. Generate with: openssl rand -base64 48
APP_SIGNING_SECRET=
# Trusted reverse proxies in front of the server (default: 0). NOTE: Fastify
# 5.12 ignores a numeric hop count (fail closed), so this has no effect yet and
# behind ngrok every client shares one IP in the auth failure limiter.
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Must start with postgresql://
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mariana

# -----------------------------------------------------------------------------
# AI - Google Gemini (required)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Model name. Must match gemini-<version>-<flash|flash-lite|pro>[-suffix]
# (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
# Sampling temperature, 0 to 2. Low values keep the reply rules obeyable
# (default: 0.3)
GEMINI_TEMPERATURE=0.3
# Reasoning depth: MINIMAL | LOW | MEDIUM | HIGH (default: LOW).
# This replaces a token budget: from Gemini 3.5 on, the API rejects
# thinkingBudget with a user error, so depth is set by thinkingLevel only.
GEMINI_THINKING_LEVEL=LOW
# Output token cap, 128 to 8192 (default: 1024). The reply is JSON and thought
# tokens are billed as output, so a tight cap truncates the JSON.
GEMINI_MAX_OUTPUT_TOKENS=1024

# -----------------------------------------------------------------------------
# Mariana flow (2026-10-28-flow-v2)
# -----------------------------------------------------------------------------
# Turn engine: v1 (current) | v2 (automation routes, AI reasons). Default: v1.
MARIANA_FLOW=v1
# Messages of the current conversation sent to the v2 model, 1 to 30
# (default: 10).
MARIANA_HISTORY_MESSAGES=10
# Timeout of one v2 "understand" Gemini call in ms, 1000 to 45000
# (default: 20000). A hung call becomes the model-failure notice.
MARIANA_UNDERSTAND_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Google OAuth / Google Calendar / Google Ads webhook (required)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be a URL on this server with path /auth/google/callback. https is
# required in production; http is accepted only for localhost outside it.
# Register the same URL in Google Cloud Console (OAuth client, redirect URIs).
GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
GOOGLE_ACCOUNT_EMAIL=consultant@example.com
# Shared secret expected in the Google Ads lead-form webhook payload
GOOGLE_ADS_WEBHOOK_KEY=your-google-ads-webhook-key

# -----------------------------------------------------------------------------
# Meta Ads webhook (required)
# -----------------------------------------------------------------------------
META_ADS_APP_SECRET=your-meta-ads-app-secret
# Graph API version, e.g. v23.0
META_ADS_GRAPH_API_VERSION=v23.0
META_ADS_VERIFY_TOKEN=your-meta-ads-verify-token
# NOTE: META_ADS_ACCESS_TOKEN is not read by the application and is not required.

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (required)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
# Graph API version, e.g. v23.0
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Timeout of each Graph API send, in ms (1000-45000). Must stay well below the 60s outbox lease.
WHATSAPP_SEND_TIMEOUT_MS=15000
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_WABA_ID=your-whatsapp-business-account-id

# -----------------------------------------------------------------------------
# Application behavior
# -----------------------------------------------------------------------------
# Debounce window (ms) before processing a burst of customer messages
# (default: 15000)
MESSAGE_DEBOUNCE_MS=15000
# Minutes a proposed appointment stays pending confirmation.
# Must be between 30 and 60 (default: 60)
SCHEDULE_CONFIRMATION_MINUTES=60

# -----------------------------------------------------------------------------
# Business profile (optional; used in AI replies when set)
# -----------------------------------------------------------------------------
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Street, 123 - City
COMPANY_CITY=Your City
COMPANY_WEBSITE=https://your-domain.example
